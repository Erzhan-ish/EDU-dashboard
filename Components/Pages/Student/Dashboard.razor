@page "/student-dashboard"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.DTOs
@using AcademicPerformanceDashboard.Models
@using AcademicPerformanceDashboard.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject StudentAnalyticsService AnalyticsService
@inject ScheduleService ScheduleService
@inject GradeService GradeService
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Dashboard Студента</PageTitle>

@if (isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else if (!isStudent)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Text="Вы не зарегистрированы как студент. Этот дашборд доступен только студентам." />
}
else
{
    <div class="dashboard-container">
        <div class="dashboard-header" style="text-align: left; margin-bottom: 2rem;">
            <h1 class="dashboard-title">Привет, @studentName!</h1>
            <p class="dashboard-subtitle">Твой академический прогресс и расписание.</p>
        </div>

        <div class="dashboard-grid-top" style="grid-template-columns: repeat(4, 1fr);">
            <div class="dashboard-card">
                <div class="stat-title">Ср. балл</div>
                <div class="stat-value neutral">@dashboardData.AverageScore</div>
            </div>
            <div class="dashboard-card">
                <div class="stat-title">Место в группе</div>
                <div class="stat-value neutral">@dashboardData.PositionInGroup / @dashboardData.TotalStudentsInGroup</div>
            </div>
            <div class="dashboard-card">
                <div class="stat-title">Предметов</div>
                <div class="stat-value neutral">@dashboardData.SubjectCount</div>
            </div>
            <div class="dashboard-card">
                <div class="stat-title">Лучший / Слабый</div>
                <div style="display: flex; justify-content: space-around; margin-top: 10px;">
                    <div style="text-align: center;">
                        <div class="stat-title" style="font-size: 0.7rem;">Лучший</div>
                        <div class="positive" style="font-weight: 700;">@dashboardData.BestSubject</div>
                    </div>
                    <div style="text-align: center;">
                        <div class="stat-title" style="font-size: 0.7rem;">Слабый</div>
                        <div class="negative" style="font-weight: 700;">@dashboardData.WeakestSubject</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-grid-middle">
            <div class="dashboard-card">
                <h2 class="dashboard-card-title">Динамика среднего балла</h2>
                <RadzenChart>
                    <RadzenLineSeries Smooth="true" Data="@timelineData" CategoryProperty="Key" Title="Ср. балл" ValueProperty="Value">
                        <RadzenMarkers MarkerType="MarkerType.Circle" />
                    </RadzenLineSeries>
                    <RadzenCategoryAxis Padding="20" />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                </RadzenChart>
            </div>
            <div class="dashboard-grid-middle-right">
                <div class="dashboard-card">
                    <h2 class="dashboard-card-title" style="color: #00e676;">📈 Рост и падение</h2>
                    @if (dashboardData.Progress.Count == 0)
                    {
                        <p style="color: #8b92a5;">Нет данных для сравнения.</p>
                    }
                    else
                    {
                        <ul class="subject-list">
                            @foreach (var p in dashboardData.Progress.OrderByDescending(p => p.Difference))
                            {
                                <li class="subject-item">
                                    <span class="subject-name">@p.SubjectName</span>
                                    @if (p.Difference > 0)
                                    {
                                        <span class="subject-score positive">+@Math.Round(p.Difference, 1)</span>
                                    }
                                    else if (p.Difference < 0)
                                    {
                                        <span class="subject-score negative">@Math.Round(p.Difference, 1)</span>
                                    }
                                    else
                                    {
                                        <span style="color: #8b92a5;">0.0</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
                
                <div class="dashboard-card">
                    <h2 class="dashboard-card-title">Расписание на сегодня</h2>
                    @if (todaySchedule.Count == 0)
                    {
                        <p style="color: #8b92a5;">На сегодня занятий нет. Отдыхай!</p>
                    }
                    else
                    {
                        <ul class="subject-list">
                            @foreach (var item in todaySchedule)
                            {
                                <li class="subject-item" style="flex-direction: column; align-items: flex-start;">
                                    <div style="display: flex; justify-content: space-between; width: 100%;">
                                        <span class="subject-name" style="font-weight: 600;">@item.Subject.Name</span>
                                        <span style="color: #8b92a5; font-size: 0.85rem;">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                                    </div>
                                    <div style="color: #5d657b; font-size: 0.85rem;">
                                        @item.Classroom | @item.Teacher.FullName
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="dashboard-card" style="margin-top: 20px;">
            <h2 class="dashboard-card-title">Последние оценки</h2>
            <RadzenDataGrid Data="@recentGrades" TItem="Grade" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                <Columns>
                    <RadzenDataGridColumn TItem="Grade" Property="Subject.Name" Title="Предмет" />
                    <RadzenDataGridColumn TItem="Grade" Property="Value" Title="Оценка">
                        <Template Context="grade">
                            <span class="@(grade.Value >= 60 ? "positive" : "negative")" style="font-weight: 600;">@grade.Value</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grade" Property="Date" Title="Дата" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="Grade" Property="Teacher.FullName" Title="Преподаватель" />
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isStudent = false;
    private string studentName = "";
    private int studentId;
    
    private StudentDashboardDto dashboardData = new();
    private List<KeyValuePair<string, double>> timelineData = new();
    private List<Grade> recentGrades = new();
    private List<ScheduleItem> todaySchedule = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                var student = await DbContext.Students.FirstOrDefaultAsync(s => s.ApplicationUserId == appUser.Id);
                if (student != null)
                {
                    isStudent = true;
                    studentName = student.FullName;
                    studentId = student.Id;

                    dashboardData = await AnalyticsService.GetStudentDashboardDataAsync(student.Id);
                    
                    var timelineDict = await AnalyticsService.GetSubjectAveragesTimelineAsync(student.Id);
                    timelineData = timelineDict.ToList();
                    
                    recentGrades = await GradeService.GetGradesByStudentAsync(student.Id);
                    todaySchedule = await ScheduleService.GetTodayScheduleAsync(student.GroupId);
                }
            }
        }
        isLoading = false;
    }

    private BadgeStyle GetBadgeStyle(int value)
    {
        if (value >= 80) return BadgeStyle.Success;
        if (value >= 60) return BadgeStyle.Info;
        if (value >= 40) return BadgeStyle.Warning;
        return BadgeStyle.Danger;
    }
}
