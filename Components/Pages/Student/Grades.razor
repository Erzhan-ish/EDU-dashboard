@page "/student-grades"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.Models
@using AcademicPerformanceDashboard.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject GradeService GradeService
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Мои Оценки</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-header" style="text-align: left; margin-bottom: 2rem;">
        <h1 class="dashboard-title">Мои Оценки</h1>
        <p class="dashboard-subtitle">История ваших оценок и фильтрация по предметам.</p>
    </div>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!isStudent)
    {
        <div class="dashboard-card">
            <p style="color: #ff5252;">Доступно только студентам.</p>
        </div>
    }
    else
    {
        <div class="dashboard-card" style="margin-bottom: 20px;">
            <div class="row g-3">
                <div class="col-md-4">
                    <RadzenDropDown AllowClear="true" TValue="int?" Class="w-100" 
                                    Data="@subjects" TextProperty="Name" ValueProperty="Id"
                                    Placeholder="Все предметы" Change="@(args => OnSubjectChanged(args))"
                                    style="background: #111625 !important; border: 1px solid #2a3149 !important; color: #fff !important;" />
                </div>
            </div>
        </div>

        <div class="dashboard-card">
            <RadzenDataGrid Data="@grades" TItem="Grade" AllowPaging="true" PageSize="10" AllowSorting="true" class="bg-transparent text-light">
                <Columns>
                    <RadzenDataGridColumn TItem="Grade" Property="Subject.Name" Title="Предмет" Sortable="true" />
                    <RadzenDataGridColumn TItem="Grade" Property="Value" Title="Оценка" Sortable="true">
                        <Template Context="grade">
                            <span class="@(grade.Value >= 60 ? "positive" : "negative")" style="font-weight: 600;">@grade.Value</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Grade" Property="Date" Title="Дата" FormatString="{0:d}" Sortable="true" />
                    <RadzenDataGridColumn TItem="Grade" Property="Teacher.FullName" Title="Преподаватель" Sortable="true" />
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isStudent = false;
    private int studentId;
    private int? selectedSubjectId;
    
    private List<Grade> grades = new();
    private List<Subject> subjects = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                var student = await DbContext.Students.FirstOrDefaultAsync(s => s.ApplicationUserId == appUser.Id);
                if (student != null)
                {
                    isStudent = true;
                    studentId = student.Id;

                    subjects = await DbContext.Subjects.OrderBy(s => s.Name).ToListAsync();
                    await LoadGrades();
                }
            }
        }
        isLoading = false;
    }

    private async Task LoadGrades()
    {
        grades = await GradeService.GetGradesByStudentAsync(studentId, selectedSubjectId);
    }

    private async Task OnSubjectChanged(object value)
    {
        selectedSubjectId = value as int?;
        await LoadGrades();
    }

    private BadgeStyle GetBadgeStyle(int value)
    {
        if (value >= 80) return BadgeStyle.Success;
        if (value >= 60) return BadgeStyle.Info;
        if (value >= 40) return BadgeStyle.Warning;
        return BadgeStyle.Danger;
    }
}
