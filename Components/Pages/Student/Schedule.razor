@page "/student-schedule"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.Models
@using AcademicPerformanceDashboard.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ScheduleService ScheduleService
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Расписание</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-header" style="text-align: left; margin-bottom: 2rem;">
        <h1 class="dashboard-title">Расписание Занятий</h1>
        <p class="dashboard-subtitle">Ваше расписание на текущую неделю.</p>
    </div>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!isStudent)
    {
        <div class="dashboard-card">
            <p style="color: #ff5252;">Доступно только студентам.</p>
        </div>
    }
    else
    {
        <div class="dashboard-grid-top" style="grid-template-columns: repeat(3, 1fr);">
            @foreach (var day in Enum.GetValues<DayOfWeek>().Where(d => d != DayOfWeek.Sunday))
            {
                var dayItems = schedule.Where(s => s.DayOfWeek == day).ToList();
                <div class="dashboard-card">
                    <h4 class="dashboard-card-title" style="color: #4da9ff;">@GetRussianDayOfWeek(day)</h4>
                    @if (dayItems.Count == 0)
                    {
                        <p style="color: #8b92a5;">Нет занятий</p>
                    }
                    else
                    {
                        <ul class="subject-list">
                            @foreach (var item in dayItems)
                            {
                                <li class="subject-item" style="flex-direction: column; align-items: flex-start;">
                                    <div style="display: flex; justify-content: space-between; width: 100%;">
                                        <span class="subject-name" style="font-weight: 600;">@item.Subject.Name</span>
                                        <span style="color: #8b92a5; font-size: 0.85rem;">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                                    </div>
                                    <div style="color: #5d657b; font-size: 0.85rem;">
                                        @item.Classroom | @item.Teacher.FullName
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isStudent = false;
    private List<ScheduleItem> schedule = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                var student = await DbContext.Students.FirstOrDefaultAsync(s => s.ApplicationUserId == appUser.Id);
                if (student != null)
                {
                    isStudent = true;
                    schedule = await ScheduleService.GetWeeklyScheduleAsync(student.GroupId);
                }
            }
        }
        isLoading = false;
    }

    private string GetRussianDayOfWeek(DayOfWeek day)
    {
        return day switch
        {
            DayOfWeek.Monday => "Понедельник",
            DayOfWeek.Tuesday => "Вторник",
            DayOfWeek.Wednesday => "Среда",
            DayOfWeek.Thursday => "Четверг",
            DayOfWeek.Friday => "Пятница",
            DayOfWeek.Saturday => "Суббота",
            _ => day.ToString()
        };
    }
}
