@page "/admin-dashboard"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.DTOs
@using Microsoft.AspNetCore.Identity
@using AcademicPerformanceDashboard.Data
@using AcademicPerformanceDashboard.Models
@using Microsoft.EntityFrameworkCore
@inject RankingService RankingService
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject Radzen.NotificationService NotificationService
@attribute [Authorize]

<PageTitle>Дашборд Администратора</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">Дашборд Администратора</h1>
        <p class="dashboard-subtitle">Управление группами, расписанием и просмотр рейтинга.</p>
    </div>

    @if (isLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <AuthorizeView>
            <Authorized>
                @if (context.User.Identity?.Name == "admin@example.com")
                {
                    <RadzenTabs RenderMode="TabRenderMode.Client" Class="mt-4">
                        <Tabs>
                            <!-- Tab: Analytics & Ranking -->
                            <RadzenTabsItem Text="Аналитика">
                                <div class="dashboard-grid-middle mt-3">
                                    <!-- Group Ranking -->
                                    <div class="dashboard-card">
                                        <h2 class="dashboard-card-title">Общий Рейтинг Групп</h2>
                                        <RadzenDataGrid Data="@groupRanking" TItem="GroupRankingDto" AllowPaging="true" PageSize="5" class="bg-transparent text-light" RowSelect="@OnGroupSelect">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="GroupRankingDto" Property="Position" Title="Место" Width="80px">
                                                    <Template Context="group">
                                                        @if (group.Position == 1)
                                                        {
                                                            <span class="badge bg-warning text-dark">🥇 1</span>
                                                        }
                                                        else if (group.Position == 2)
                                                        {
                                                            <span class="badge bg-secondary">🥈 2</span>
                                                        }
                                                        else if (group.Position == 3)
                                                        {
                                                            <span class="badge" style="background-color: #cd7f32;">🥉 3</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@group.Position</span>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="GroupRankingDto" Property="GroupName" Title="Группа" />
                                                <RadzenDataGridColumn TItem="GroupRankingDto" Property="AverageScore" Title="Ср. балл">
                                                    <Template Context="group">
                                                        <span class="fw-bold @(group.AverageScore >= 60 ? "positive" : "negative")">@group.AverageScore</span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>
                                        </RadzenDataGrid>
                                    </div>

                                    @if (selectedGroupIdForDetails != 0)
                                    {
                                        <div class="dashboard-card">
                                            <h2 class="dashboard-card-title">Состав группы: @selectedGroupNameForDetails</h2>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <h3 class="text-light mb-2">Студенты</h3>
                                                    <RadzenDataGrid Data="@selectedGroupStudents" TItem="Student" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                                                        <Columns>
                                                            <RadzenDataGridColumn TItem="Student" Property="FullName" Title="ФИО" />
                                                        </Columns>
                                                    </RadzenDataGrid>
                                                </div>
                                                <div class="col-md-6">
                                                    <h3 class="text-light mb-2">Преподаватели</h3>
                                                    <RadzenDataGrid Data="@selectedGroupTeachers" TItem="TeacherSubjectDto" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                                                        <Columns>
                                                            <RadzenDataGridColumn TItem="TeacherSubjectDto" Property="TeacherName" Title="Имя" />
                                                            <RadzenDataGridColumn TItem="TeacherSubjectDto" Property="SubjectName" Title="Предмет" />
                                                        </Columns>
                                                    </RadzenDataGrid>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </RadzenTabsItem>

                            <!-- Tab: Users Management -->
                            <RadzenTabsItem Text="Пользователи">
                                <div class="dashboard-card mt-3">
                                    <h2 class="dashboard-card-title" style="color: #00e676;">Создать пользователя</h2>
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label text-light">Email</label>
                                            <RadzenTextBox @bind-Value="newUserEmail" Class="w-100" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-light">Пароль</label>
                                            <RadzenTextBox @bind-Value="newUserPassword" Class="w-100" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-light">ФИО</label>
                                            <RadzenTextBox @bind-Value="newUserFullName" Class="w-100" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-light">Роль</label>
                                            <RadzenDropDown @bind-Value="newUserRole" Data="@userRoles" Class="w-100" />
                                        </div>
                                        @if (newUserRole == "Студент")
                                        {
                                            <div class="col-md-2">
                                                <label class="form-label text-light">Группа</label>
                                                <RadzenDropDown @bind-Value="newUserGroupId" Data="@groups" TextProperty="Name" ValueProperty="Id" Class="w-100" />
                                            </div>
                                        }
                                        <div class="col-md-2">
                                            <RadzenButton Text="Создать" ButtonStyle="ButtonStyle.Success" Click=@CreateUser Class="w-100" />
                                        </div>
                                    </div>
                                </div>

                                <div class="dashboard-card mt-4">
                                    <h2 class="dashboard-card-title">Список пользователей</h2>
                                    <RadzenDataGrid @ref="usersGrid" Data="@allUsers" TItem="UserManagementDto" AllowPaging="true" PageSize="10" 
                                                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                    class="bg-transparent text-light" RowUpdate="@OnUpdateRowUser">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="UserManagementDto" Property="Email" Title="Email" />
                                            <RadzenDataGridColumn TItem="UserManagementDto" Property="FullName" Title="ФИО">
                                                <EditTemplate Context="user">
                                                    <RadzenTextBox @bind-Value="user.FullName" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="UserManagementDto" Property="Role" Title="Роль" />
                                            <RadzenDataGridColumn TItem="UserManagementDto" Property="GroupName" Title="Группа">
                                                <EditTemplate Context="user">
                                                    @if (user.Role == "Студент")
                                                    {
                                                        <RadzenDropDown @bind-Value="user.GroupId" Data="@groups" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="UserManagementDto" Title="Действия" Width="120px" TextAlign="TextAlign.Center">
                                                <Template Context="user">
                                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(args => EditRowUser(user))" />
                                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click=@(() => DeleteUser(user.Id)) />
                                                </Template>
                                                <EditTemplate Context="user">
                                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRowUser(user))" />
                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@((args) => CancelEditUser(user))" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </div>
                            </RadzenTabsItem>

                            <!-- Tab: Groups Management -->
                            <RadzenTabsItem Text="Группы">
                                <div class="dashboard-card mt-3">
                                    <h2 class="dashboard-card-title" style="color: #00e676;">Создать группу</h2>
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-6">
                                            <RadzenLabel Text="Название группы" />
                                            <RadzenTextBox @bind-Value="newGroupName" Class="w-100" />
                                        </div>
                                        <div class="col-md-4">
                                            <RadzenLabel Text="Курс" />
                                            <RadzenNumeric TValue="int" @bind-Value="newGroupCourse" Min="1" Max="6" Class="w-100" />
                                        </div>
                                        <div class="col-md-2">
                                            <RadzenButton Text="Создать" ButtonStyle="ButtonStyle.Success" Click=@CreateGroup Class="w-100" />
                                        </div>
                                    </div>
                                </div>

                                <div class="dashboard-card mt-4">
                                    <h2 class="dashboard-card-title">Список групп</h2>
                                    <RadzenDataGrid @ref="groupsGrid" Data="@groups" TItem="AcademicPerformanceDashboard.Models.Group" AllowPaging="true" PageSize="10" 
                                                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                    class="bg-transparent text-light" RowUpdate="@OnUpdateRowGroup">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="AcademicPerformanceDashboard.Models.Group" Property="Name" Title="Название">
                                                <EditTemplate Context="group">
                                                    <RadzenTextBox @bind-Value="group.Name" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AcademicPerformanceDashboard.Models.Group" Property="Course" Title="Курс">
                                                <EditTemplate Context="group">
                                                    <RadzenNumeric TValue="int" @bind-Value="group.Course" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="AcademicPerformanceDashboard.Models.Group" Title="Действия" Width="150px" TextAlign="TextAlign.Center">
                                                <Template Context="group">
                                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(args => EditRowGroup(group))" @onclick:stopPropagation="true" />
                                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click=@(() => DeleteGroup(group.Id)) @onclick:stopPropagation="true" />
                                                </Template>
                                                <EditTemplate Context="group">
                                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRowGroup(group))" />
                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@((args) => CancelEditGroup(group))" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </div>
                            </RadzenTabsItem>

                            <!-- Tab: Subjects & Bindings -->
                            <RadzenTabsItem Text="Предметы">
                                <div class="row g-3 mt-3">
                                    <div class="col-md-6">
                                        <div class="dashboard-card">
                                            <h2 class="dashboard-card-title" style="color: #ffb74d;">Добавить предмет</h2>
                                            <div class="d-flex gap-2">
                                                <RadzenTextBox @bind-Value="newSubjectName" Class="flex-grow-1" Placeholder="Название предмета" />
                                                <RadzenButton Text="Добавить" ButtonStyle="ButtonStyle.Warning" Click=@CreateSubject />
                                            </div>
                                            <div class="mt-4">
                                                <RadzenDataGrid @ref="subjectsGrid" Data="@subjects" TItem="Subject" AllowPaging="true" PageSize="5" 
                                                                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                                class="bg-transparent text-light" RowUpdate="@OnUpdateRowSubject">
                                                    <Columns>
                                                        <RadzenDataGridColumn TItem="Subject" Property="Name" Title="Название">
                                                            <EditTemplate Context="subject">
                                                                <RadzenTextBox @bind-Value="subject.Name" Style="width:100%" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="Subject" Title="Действия" Width="120px">
                                                            <Template Context="s">
                                                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(args => EditRowSubject(s))" />
                                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click=@(() => DeleteSubject(s.Id)) />
                                                            </Template>
                                                            <EditTemplate Context="s">
                                                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRowSubject(s))" />
                                                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@((args) => CancelEditSubject(s))" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                </RadzenDataGrid>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="dashboard-card">
                                            <h2 class="dashboard-card-title" style="color: #a1a8b9;">Привязки (Преподаватель-Предмет-Группа)</h2>
                                            <div class="row g-2">
                                                <div class="col-md-4">
                                                    <RadzenDropDown @bind-Value="selectedSubjectIdForBind" Data="@subjects" TextProperty="Name" ValueProperty="Id" Class="w-100" Placeholder="Предмет" />
                                                </div>
                                                <div class="col-md-4">
                                                    <RadzenDropDown @bind-Value="selectedTeacherIdForBind" Data="@teachers" TextProperty="FullName" ValueProperty="Id" Class="w-100" Placeholder="Преподаватель" />
                                                </div>
                                                <div class="col-md-4">
                                                    <RadzenDropDown @bind-Value="selectedGroupIdForBind" Data="@groups" TextProperty="Name" ValueProperty="Id" Class="w-100" Placeholder="Группа" />
                                                </div>
                                                <div class="col-md-12">
                                                    <RadzenButton Text="Привязать" ButtonStyle="ButtonStyle.Secondary" Click=@BindTeacherToSubject Class="w-100" />
                                                </div>
                                            </div>
                                            <div class="mt-4">
                                                <RadzenDataGrid @ref="bindingsGrid" Data="@allBindings" TItem="TeacherSubjectGroup" AllowPaging="true" PageSize="5" 
                                                                AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                                class="bg-transparent text-light" RowUpdate="@OnUpdateRowBinding">
                                                    <Columns>
                                                        <RadzenDataGridColumn TItem="TeacherSubjectGroup" Property="Subject.Name" Title="Предмет">
                                                            <EditTemplate Context="b">
                                                                <RadzenDropDown @bind-Value="b.SubjectId" Data="@subjects" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="TeacherSubjectGroup" Property="Teacher.FullName" Title="Преподаватель">
                                                            <EditTemplate Context="b">
                                                                <RadzenDropDown @bind-Value="b.TeacherId" Data="@teachers" TextProperty="FullName" ValueProperty="Id" Style="width:100%" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="TeacherSubjectGroup" Property="Group.Name" Title="Группа">
                                                            <EditTemplate Context="b">
                                                                <RadzenDropDown @bind-Value="b.GroupId" Data="@groups" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                        <RadzenDataGridColumn TItem="TeacherSubjectGroup" Title="Действия" Width="120px">
                                                            <Template Context="b">
                                                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(args => EditRowBinding(b))" />
                                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click=@(() => DeleteBinding(b.Id)) />
                                                            </Template>
                                                            <EditTemplate Context="b">
                                                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRowBinding(b))" />
                                                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@((args) => CancelEditBinding(b))" />
                                                            </EditTemplate>
                                                        </RadzenDataGridColumn>
                                                    </Columns>
                                                </RadzenDataGrid>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </RadzenTabsItem>

                            <!-- Tab: Schedule -->
                            <RadzenTabsItem Text="Расписание">
                                <div class="dashboard-card mt-3">
                                    <h2 class="dashboard-card-title" style="color: #4da9ff;">Добавить в расписание</h2>
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label text-light">Группа</label>
                                            <RadzenDropDown TValue="int" Data="@groups" TextProperty="Name" ValueProperty="Id" Class="w-100" @bind-Value="selectedGroupId" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-light">Предмет</label>
                                            <RadzenDropDown TValue="int" Data="@subjects" TextProperty="Name" ValueProperty="Id" Class="w-100" @bind-Value="selectedSubjectId" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-light">Преподаватель</label>
                                            <RadzenDropDown TValue="int" Data="@teachers" TextProperty="FullName" ValueProperty="Id" Class="w-100" @bind-Value="selectedTeacherId" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-light">День</label>
                                            <RadzenDropDown TValue="DayOfWeek" Data="@daysOfWeek" Class="w-100" @bind-Value="selectedDay" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-light">Начало</label>
                                            <RadzenDatePicker TValue="TimeOnly" @bind-Value="startTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Class="w-100" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-light">Конец</label>
                                            <RadzenDatePicker TValue="TimeOnly" @bind-Value="endTime" ShowTime="true" TimeOnly="true" DateFormat="HH:mm" Class="w-100" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-light">Аудитория</label>
                                            <RadzenTextBox @bind-Value="classroom" Class="w-100" />
                                        </div>
                                        <div class="col-md-4">
                                            <RadzenButton Text="Добавить" ButtonStyle="ButtonStyle.Primary" Click=@AddScheduleItem Class="w-100" />
                                        </div>
                                    </div>
                                </div>

                                <div class="dashboard-card mt-4">
                                    <h2 class="dashboard-card-title">Текущее расписание</h2>
                                    <RadzenDataGrid @ref="scheduleGrid" Data="@allScheduleItems" TItem="ScheduleItem" AllowPaging="true" PageSize="10" 
                                                    AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                                                    class="bg-transparent text-light" RowUpdate="@OnUpdateRowSchedule">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Property="Group.Name" Title="Группа">
                                                <EditTemplate Context="item">
                                                    <RadzenDropDown @bind-Value="item.GroupId" Data="@groups" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Property="Subject.Name" Title="Предмет">
                                                <EditTemplate Context="item">
                                                    <RadzenDropDown @bind-Value="item.SubjectId" Data="@subjects" TextProperty="Name" ValueProperty="Id" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Property="Teacher.FullName" Title="Препод">
                                                <EditTemplate Context="item">
                                                    <RadzenDropDown @bind-Value="item.TeacherId" Data="@teachers" TextProperty="FullName" ValueProperty="Id" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Property="DayOfWeek" Title="День">
                                                <EditTemplate Context="item">
                                                    <RadzenDropDown @bind-Value="item.DayOfWeek" Data="@daysOfWeek" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Title="Время">
                                                <Template Context="item">
                                                    @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                                </Template>
                                                <EditTemplate Context="item">
                                                    <div class="d-flex flex-column gap-1">
                                                        <RadzenDatePicker TValue="DateTime?" Value="@(DateTime.Today.Add(item.StartTime))" 
                                                                        ShowTime="true" TimeOnly="true" DateFormat="HH:mm" 
                                                                        Change="@(args => item.StartTime = args.HasValue ? args.Value.TimeOfDay : item.StartTime)" 
                                                                        Class="w-100" />
                                                        <RadzenDatePicker TValue="DateTime?" Value="@(DateTime.Today.Add(item.EndTime))" 
                                                                        ShowTime="true" TimeOnly="true" DateFormat="HH:mm" 
                                                                        Change="@(args => item.EndTime = args.HasValue ? args.Value.TimeOfDay : item.EndTime)" 
                                                                        Class="w-100" />
                                                    </div>
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Property="Classroom" Title="Ауд.">
                                                <EditTemplate Context="item">
                                                    <RadzenTextBox @bind-Value="item.Classroom" Style="width:100%" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="ScheduleItem" Title="Действия" Width="120px">
                                                <Template Context="item">
                                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(args => EditRowSchedule(item))" />
                                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click=@(() => DeleteScheduleItem(item.Id)) />
                                                </Template>
                                                <EditTemplate Context="item">
                                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRowSchedule(item))" />
                                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@((args) => CancelEditSchedule(item))" />
                                                </EditTemplate>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </div>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                }

                else
                {
                    <div class="dashboard-card">
                        <p style="color: #ff5252;">Доступно только администраторам.</p>
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <div class="dashboard-card">
                    <p style="color: #ff5252;">Вы не авторизованы.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    private bool isLoading = true;
    private List<GroupRankingDto> groupRanking = new();
    
    private List<AcademicPerformanceDashboard.Models.Group> groups = new();
    private List<Subject> subjects = new();
    private List<Teacher> teachers = new();
    private List<UserManagementDto> allUsers = new();
    private List<ScheduleItem> allScheduleItems = new();
    private List<TeacherSubjectGroup> allBindings = new();
    
    // Create Subject form
    private string newSubjectName = "";
    
    // Bind form
    private int selectedSubjectIdForBind;
    private int selectedTeacherIdForBind;
    private int selectedGroupIdForBind;
    
    // Group Details
    private int selectedGroupIdForDetails;
    private string selectedGroupNameForDetails = "";
    private List<Student> selectedGroupStudents = new();
    private List<TeacherSubjectDto> selectedGroupTeachers = new();

    private class TeacherSubjectDto
    {
        public string TeacherName { get; set; } = "";
        public string SubjectName { get; set; } = "";
    }

    private class UserManagementDto
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Role { get; set; } = "";
        public int? GroupId { get; set; }
        public string? GroupName { get; set; }
    }
    
    // Create Group form
    private string newGroupName = "";
    private int newGroupCourse = 1;
    
    // Create User form
    private string newUserEmail = "";
    private string newUserPassword = "";
    private string newUserFullName = "";
    private string newUserRole = "Студент";
    private int newUserGroupId;
    
    private List<string> userRoles = new() { "Студент", "Преподаватель" };
    
    // Schedule form
    private int selectedGroupId;
    private int selectedSubjectId;
    private int selectedTeacherId;
