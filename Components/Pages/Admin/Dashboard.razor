    private async Task LoadAllData()
    {
        groupRanking = await RankingService.GetGroupRankingAsync();
        groups = await DbContext.Groups.OrderBy(g => g.Name).ToListAsync();
        subjects = await DbContext.Subjects.OrderBy(s => s.Name).ToListAsync();
        teachers = await DbContext.Teachers.OrderBy(t => t.FullName).ToListAsync();
        
        allScheduleItems = await DbContext.ScheduleItems
            .Include(s => s.Group)
            .Include(s => s.Subject)
            .Include(s => s.Teacher)
            .ToListAsync();
            
        allBindings = await DbContext.TeacherSubjectGroups
            .Include(t => t.Group)
            .Include(t => t.Subject)
            .Include(t => t.Teacher)
            .ToListAsync();

        var users = await UserManager.Users.ToListAsync();
        allUsers = new List<UserManagementDto>();
        foreach (var u in users)
        {
            if (u.Email == "admin@example.com") continue;
            
            var roles = await UserManager.GetRolesAsync(u);
            var role = roles.FirstOrDefault() ?? "Студент";
            
            var dto = new UserManagementDto
            {
                Id = u.Id,
                Email = u.Email ?? "",
                FullName = u.FullName,
                Role = role
            };

            if (role == "Студент")
            {
                var student = await DbContext.Students.Include(s => s.Group).FirstOrDefaultAsync(s => s.ApplicationUserId == u.Id);
                if (student != null)
                {
                    dto.GroupId = student.GroupId;
                    dto.GroupName = student.Group?.Name;
                }
            }
            allUsers.Add(dto);
        }
    }

    private async Task CreateGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Введите название группы" });
            return;
        }

        var group = new AcademicPerformanceDashboard.Models.Group
        {
            Name = newGroupName,
            Course = newGroupCourse
        };

        DbContext.Groups.Add(group);
        await DbContext.SaveChangesAsync();

        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Успешно", Detail = $"Группа {newGroupName} создана" });
        
        newGroupName = "";
        newGroupCourse = 1;
        
        await LoadAllData();
    }

    private async Task AddScheduleItem()
    {
        if (selectedGroupId == 0 || selectedSubjectId == 0 || selectedTeacherId == 0)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Выберите группу, предмет и преподавателя" });
            return;
        }

        if (string.IsNullOrWhiteSpace(classroom))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Введите аудиторию" });
            return;
        }

        TimeSpan startTimeSp = new TimeSpan(startTime.Hour, startTime.Minute, 0);
        TimeSpan endTimeSp = new TimeSpan(endTime.Hour, endTime.Minute, 0);

        var scheduleItem = new ScheduleItem
        {
            GroupId = selectedGroupId,
            SubjectId = selectedSubjectId,
            TeacherId = selectedTeacherId,
            DayOfWeek = selectedDay,
            StartTime = startTimeSp,
            EndTime = endTimeSp,
            Classroom = classroom
        };

        DbContext.ScheduleItems.Add(scheduleItem);
        
        // Also ensure TeacherSubjectGroup exists
        var tsg = await DbContext.TeacherSubjectGroups
            .FirstOrDefaultAsync(t => t.GroupId == selectedGroupId && t.SubjectId == selectedSubjectId && t.TeacherId == selectedTeacherId);
            
        if (tsg == null)
        {
            DbContext.TeacherSubjectGroups.Add(new TeacherSubjectGroup
            {
                GroupId = selectedGroupId,
                SubjectId = selectedSubjectId,
                TeacherId = selectedTeacherId
            });
        }

        await DbContext.SaveChangesAsync();

        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Успешно", Detail = "Элемент расписания добавлен" });
        classroom = "";
        await LoadAllData();
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserPassword) || string.IsNullOrWhiteSpace(newUserFullName))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Заполните все обязательные поля" });
            return;
        }

        if (newUserRole == "Студент" && newUserGroupId == 0)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Выберите группу для студента" });
            return;
        }

        var user = new ApplicationUser { UserName = newUserEmail, Email = newUserEmail, EmailConfirmed = true, FullName = newUserFullName };
        var result = await UserManager.CreateAsync(user, newUserPassword);

        if (result.Succeeded)
        {
            if (newUserRole == "Студент")
            {
                var student = new Student
                {
                    ApplicationUserId = user.Id,
                    FullName = newUserFullName,
                    GroupId = newUserGroupId
                };
                DbContext.Students.Add(student);
            }
            else if (newUserRole == "Преподаватель")
            {
                var teacher = new Teacher
                {
                    ApplicationUserId = user.Id,
                    FullName = newUserFullName
                };
                DbContext.Teachers.Add(teacher);
            }

            await UserManager.AddToRoleAsync(user, newUserRole);
            await DbContext.SaveChangesAsync();

            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Успешно", Detail = $"Пользователь {newUserEmail} создан" });

            newUserEmail = "";
            newUserPassword = "";
            newUserFullName = "";
            newUserGroupId = 0;
            
            await LoadAllData();
        }
        else
        {
            var errorMsg = string.Join(", ", result.Errors.Select(e => e.Description));
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = errorMsg });
        }
    }

