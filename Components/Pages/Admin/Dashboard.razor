    async Task OnUpdateRowUser(UserManagementDto userDto)
    {
        var user = await UserManager.FindByIdAsync(userDto.Id);
        if (user != null)
        {
            user.FullName = userDto.FullName;
            await UserManager.UpdateAsync(user);
            
            // Update linked profile
            if (userDto.Role == "Студент")
            {
                var student = await DbContext.Students.FirstOrDefaultAsync(s => s.ApplicationUserId == user.Id);
                if (student != null)
                {
                    student.FullName = userDto.FullName;
                    student.GroupId = userDto.GroupId ?? student.GroupId;
                }
            }
            else if (userDto.Role == "Преподаватель")
            {
                var teacher = await DbContext.Teachers.FirstOrDefaultAsync(t => t.ApplicationUserId == user.Id);
                if (teacher != null)
                {
                    teacher.FullName = userDto.FullName;
                }
            }
            
            await DbContext.SaveChangesAsync();
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Успешно", Detail = "Пользователь обновлен" });
            await LoadAllData();
        }
    }

