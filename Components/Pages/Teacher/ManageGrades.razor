@page "/teacher-grades"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.Models
@using AcademicPerformanceDashboard.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject GradeService GradeService
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService
@attribute [Authorize]

<PageTitle>Управление Оценками</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1 class="dashboard-title">Управление Оценками</h1>
        <p class="dashboard-subtitle">Выставляйте оценки и просматривайте историю.</p>
    </div>

    @if (isLoading)
    {
        <div class="dashboard-container">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else if (!isTeacher)
    {
        <div class="dashboard-card">
            <p style="color: #ff5252;">Доступно только преподавателям.</p>
        </div>
    }
    else
    {
        <div class="dashboard-card mb-4">
            <h2 class="dashboard-card-title">Фильтры</h2>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <RadzenLabel Text="Группа" style="color: #8b92a5; font-size: 0.85rem; margin-bottom: 0.25rem; display: block;" />
                    <RadzenDropDown TValue="int?" Data="@teacherGroups" TextProperty="Name" ValueProperty="Id" Class="w-100 bg-transparent text-light border-secondary"
                                    Change="@(args => OnGroupChanged(args))" Placeholder="Выберите группу" />
                </div>
                <div class="col-md-4">
                    <RadzenLabel Text="Предмет" style="color: #8b92a5; font-size: 0.85rem; margin-bottom: 0.25rem; display: block;" />
                    <RadzenDropDown TValue="int?" Data="@teacherSubjects" TextProperty="Name" ValueProperty="Id" Class="w-100 bg-transparent text-light border-secondary"
                                    Change="@(args => OnSubjectChanged(args))" Placeholder="Выберите предмет" Disabled="@(selectedGroupId == null)" />
                </div>
                <div class="col-md-4">
                    <RadzenLabel Text="Студент" style="color: #8b92a5; font-size: 0.85rem; margin-bottom: 0.25rem; display: block;" />
                    <RadzenDropDown TValue="int?" Data="@students" TextProperty="FullName" ValueProperty="Id" Class="w-100 bg-transparent text-light border-secondary"
                                    Change="@(args => OnStudentChanged(args))" Placeholder="Выберите студента" Disabled="@(selectedSubjectId == null)" />
                </div>
            </div>
        </div>

        @if (selectedStudentId != null && selectedSubjectId != null)
        {
            <div class="dashboard-card mb-4">
                <h2 class="dashboard-card-title" style="color: #00e676;">Новая оценка</h2>
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <RadzenLabel Text="Оценка (0-100)" style="color: #8b92a5; font-size: 0.85rem; margin-bottom: 0.25rem; display: block;" />
                        <RadzenNumeric TValue="int" @bind-Value="newGradeValue" Min="0" Max="100" Class="w-100 bg-transparent text-light border-secondary" />
                    </div>
                    <div class="col-md-6">
                        <RadzenLabel Text="Комментарий (необязательно)" style="color: #8b92a5; font-size: 0.85rem; margin-bottom: 0.25rem; display: block;" />
                        <RadzenTextBox @bind-Value="newGradeComment" Class="w-100 bg-transparent text-light border-secondary" />
                    </div>
                    <div class="col-md-3">
                        <RadzenButton Text="Добавить Оценку" ButtonStyle="ButtonStyle.Success" Click=@AddGrade Class="w-100" style="background: #00e676; color: #0f121d;" />
                    </div>
                </div>
            </div>

            <div class="dashboard-card">
                <h2 class="dashboard-card-title">История оценок студента по предмету</h2>
                <RadzenDataGrid Data="@studentGrades" TItem="Grade" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                    <Columns>
                        <RadzenDataGridColumn TItem="Grade" Property="Value" Title="Оценка">
                            <Template Context="grade">
                                <span class="@(grade.Value >= 60 ? "positive" : "negative")" style="font-weight: 600;">@grade.Value</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Grade" Property="Date" Title="Дата" FormatString="{0:d}" />
                        <RadzenDataGridColumn TItem="Grade" Property="Comment" Title="Комментарий" />
                        <RadzenDataGridColumn TItem="Grade" Context="grade" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px">
                            <Template Context="grade">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Small" Click=@(args => DeleteGrade(grade)) @onclick:stopPropagation="true" style="background: #ff5252; border: none;" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private bool isTeacher = false;
    private int teacherId;

    private List<AcademicPerformanceDashboard.Models.Group> teacherGroups = new();
    private List<Subject> teacherSubjects = new();
    private List<Student> students = new();
    private List<Grade> studentGrades = new();

    private int? selectedGroupId;
    private int? selectedSubjectId;
    private int? selectedStudentId;

    private int newGradeValue = 0;
    private string newGradeComment = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                var teacher = await DbContext.Teachers.FirstOrDefaultAsync(t => t.ApplicationUserId == appUser.Id);
                if (teacher != null)
                {
                    isTeacher = true;
                    teacherId = teacher.Id;

                    teacherGroups = await DbContext.TeacherSubjectGroups
                        .Where(tsg => tsg.TeacherId == teacherId)
                        .Select(tsg => tsg.Group)
                        .Distinct()
                        .ToListAsync();
                }
            }
        }
        isLoading = false;
    }

    private async Task OnGroupChanged(object value)
    {
        selectedGroupId = value as int?;
        selectedSubjectId = null;
        selectedStudentId = null;
        teacherSubjects.Clear();
        students.Clear();
        studentGrades.Clear();

        if (selectedGroupId != null)
        {
            teacherSubjects = await DbContext.TeacherSubjectGroups
                .Where(tsg => tsg.TeacherId == teacherId && tsg.GroupId == selectedGroupId)
                .Select(tsg => tsg.Subject)
                .Distinct()
                .ToListAsync();
        }
    }

    private async Task OnSubjectChanged(object value)
    {
        selectedSubjectId = value as int?;
        selectedStudentId = null;
        students.Clear();
        studentGrades.Clear();

        if (selectedSubjectId != null && selectedGroupId != null)
        {
            students = await DbContext.Students
                .Where(s => s.GroupId == selectedGroupId)
                .OrderBy(s => s.FullName)
                .ToListAsync();
        }
    }

    private async Task OnStudentChanged(object value)
    {
        selectedStudentId = value as int?;
        await LoadStudentGrades();
    }

    private async Task LoadStudentGrades()
    {
        if (selectedStudentId != null && selectedSubjectId != null)
        {
            studentGrades = await DbContext.Grades
                .Where(g => g.StudentId == selectedStudentId && g.SubjectId == selectedSubjectId)
                .OrderByDescending(g => g.Date)
                .ToListAsync();
        }
        else
        {
            studentGrades.Clear();
        }
    }

    private async Task AddGrade()
    {
        if (selectedStudentId == null || selectedSubjectId == null)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Ошибка", Detail = "Выберите студента и предмет" });
            return;
        }

        var grade = new Grade
        {
            StudentId = selectedStudentId.Value,
            SubjectId = selectedSubjectId.Value,
            TeacherId = teacherId,
            Value = newGradeValue,
            Date = DateTime.Now,
            Comment = string.IsNullOrWhiteSpace(newGradeComment) ? null : newGradeComment
        };

        await GradeService.CreateGradeAsync(grade);
        newGradeValue = 0;
        newGradeComment = "";
        
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Успешно", Detail = "Оценка добавлена" });
        await LoadStudentGrades();
    }

    private async Task DeleteGrade(Grade grade)
    {
        await GradeService.DeleteGradeAsync(grade.Id);
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Удалено", Detail = "Оценка удалена" });
        await LoadStudentGrades();
    }
}
