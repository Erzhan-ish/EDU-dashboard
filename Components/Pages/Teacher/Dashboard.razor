@page "/teacher-dashboard"
@rendermode InteractiveServer
@using AcademicPerformanceDashboard.Services
@using AcademicPerformanceDashboard.Models
@using AcademicPerformanceDashboard.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Дашборд Преподавателя</PageTitle>

@if (isLoading)
{
    <div class="dashboard-container">
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </div>
}
else if (!isTeacher)
{
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Ошибка доступа</h1>
            <p class="dashboard-subtitle">Этот дашборд доступен только преподавателям.</p>
        </div>
    </div>
}
else
{
    <div class="dashboard-container">
        <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <div style="text-align: left;">
                <h1 class="dashboard-title">Здравствуйте, @teacherName!</h1>
                <p class="dashboard-subtitle">Аналитика по вашим группам.</p>
            </div>
            <RadzenButton Text="Управление Оценками" ButtonStyle="ButtonStyle.Primary" Click=@(() => NavigationManager.NavigateTo("teacher-grades")) style="background: #4da9ff; border-radius: 8px;" />
        </div>

        <div class="dashboard-grid-top" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
            @foreach (var g in groupStats)
            {
                <div class="dashboard-card" style="text-align: center;">
                    <h4 style="color: #4da9ff; font-weight: 600; margin-bottom: 0.5rem;">@g.GroupName</h4>
                    <div class="stat-title">Средний балл</div>
                    <div class="stat-value neutral">@Math.Round(g.AverageScore, 1)</div>
                    <div style="color: #8b92a5; font-size: 0.85rem; margin-top: 0.5rem;">@g.StudentCount студентов</div>
                </div>
            }
        </div>

        <div class="dashboard-grid-middle" style="margin-top: 2rem;">
            <div class="dashboard-card">
                <h2 class="dashboard-card-title" style="color: #ff5252;">⚠️ Студенты с низкой успеваемостью</h2>
                <RadzenDataGrid Data="@weakStudents" TItem="dynamic" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                    <Columns>
                        <RadzenDataGridColumn TItem="dynamic" Property="StudentName" Title="Студент" />
                        <RadzenDataGridColumn TItem="dynamic" Property="GroupName" Title="Группа" />
                        <RadzenDataGridColumn TItem="dynamic" Property="AverageScore" Title="Ср. балл">
                            <Template Context="data">
                                <span class="text-danger fw-bold">@Math.Round(data.AverageScore, 1)</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
            
            <div class="dashboard-card">
                <h2 class="dashboard-card-title">Последние выставленные оценки</h2>
                <RadzenDataGrid Data="@recentGrades" TItem="Grade" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                    <Columns>
                        <RadzenDataGridColumn TItem="Grade" Property="Student.FullName" Title="Студент">
                            <Template Context="grade">
                                <span title="@grade.Student.FullName">@grade.Student.FullName</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Grade" Property="Subject.Name" Title="Предмет">
                            <Template Context="grade">
                                <span title="@grade.Subject.Name">@grade.Subject.Name</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Grade" Property="Value" Title="Оценка">
                            <Template Context="grade">
                                <span class="@(grade.Value >= 60 ? "positive" : "negative")" style="font-weight: 600;">@grade.Value</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Grade" Property="Date" Title="Дата" FormatString="{0:d}" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>

        <div class="dashboard-card" style="margin-top: 2rem;">
            <h2 class="dashboard-card-title">Ваше Расписание</h2>
            <RadzenDataGrid Data="@teacherSchedule" TItem="ScheduleItem" AllowPaging="true" PageSize="5" class="bg-transparent text-light">
                <Columns>
                    <RadzenDataGridColumn TItem="ScheduleItem" Property="DayOfWeek" Title="День" />
                    <RadzenDataGridColumn TItem="ScheduleItem" Property="StartTime" Title="Время">
                        <Template Context="item">
                            <span>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ScheduleItem" Property="Group.Name" Title="Группа" />
                    <RadzenDataGridColumn TItem="ScheduleItem" Property="Subject.Name" Title="Предмет" />
                    <RadzenDataGridColumn TItem="ScheduleItem" Property="Classroom" Title="Аудитория" />
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = null!;

    private bool isLoading = true;
    private bool isTeacher = false;
    private string teacherName = "";
    
    private List<GroupStat> groupStats = new();
    private List<dynamic> weakStudents = new();
    private List<Grade> recentGrades = new();
    private List<ScheduleItem> teacherSchedule = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                var teacher = await DbContext.Teachers.FirstOrDefaultAsync(t => t.ApplicationUserId == appUser.Id);
                if (teacher != null)
                {
                    isTeacher = true;
                    teacherName = teacher.FullName;

                    // Fetch associated groups
                    var groups = await DbContext.TeacherSubjectGroups
                        .Where(tsg => tsg.TeacherId == teacher.Id)
                        .Select(tsg => tsg.Group)
                        .Distinct()
                        .ToListAsync();

                    var allGradesForTeacher = await DbContext.Grades
                        .Include(g => g.Student)
                        .ThenInclude(s => s.Group)
                        .Include(g => g.Subject)
                        .Where(g => g.TeacherId == teacher.Id)
                        .ToListAsync();

                    var scheduleList = await DbContext.ScheduleItems
                        .Include(s => s.Group)
                        .Include(s => s.Subject)
                        .Where(s => s.TeacherId == teacher.Id)
                        .ToListAsync();

                    teacherSchedule = scheduleList
                        .OrderBy(s => s.DayOfWeek)
                        .ThenBy(s => s.StartTime)
                        .ToList();

                    foreach (var g in groups)
                    {
                        var gradesForGroup = allGradesForTeacher.Where(grade => grade.Student.GroupId == g.Id).ToList();
                        var stdCount = await DbContext.Students.CountAsync(s => s.GroupId == g.Id);
                        groupStats.Add(new GroupStat
                        {
                            GroupName = g.Name,
                            StudentCount = stdCount,
                            AverageScore = gradesForGroup.Count > 0 ? gradesForGroup.Average(x => x.Value) : 0
                        });
                    }

                    // Weak students (< 60)
                    var studentAverages = allGradesForTeacher.GroupBy(g => g.Student)
                        .Select(g => new { Student = g.Key, Avg = g.Average(x => x.Value) })
                        .Where(x => x.Avg < 60)
                        .OrderBy(x => x.Avg)
                        .Take(10)
                        .ToList();

                    foreach (var sa in studentAverages)
                    {
                        weakStudents.Add(new { StudentName = sa.Student.FullName, GroupName = sa.Student.Group.Name, AverageScore = sa.Avg });
                    }

                    recentGrades = allGradesForTeacher.OrderByDescending(g => g.Date).Take(10).ToList();
                }
            }
        }
        isLoading = false;
    }

    private class GroupStat
    {
        public string GroupName { get; set; } = string.Empty;
        public int StudentCount { get; set; }
        public double AverageScore { get; set; }
    }
}
