@inherits LayoutComponentBase
@using AcademicPerformanceDashboard.Data
@using AcademicPerformanceDashboard.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<div class="page">
    <header class="top-nav">
        <div class="nav-container">
            <span class="brand">EDU Dashboard</span>
            <nav>
                <AuthorizeView>
                    <Authorized>
                        @if (isAdmin)
                        {
                            <a href="/admin-dashboard">Админ</a>
                        }
                        else if (isTeacher)
                        {
                            <a href="/teacher-dashboard">Преподаватель</a>
                        }
                        else if (isStudent)
                        {
                            <a href="/">Студент</a>
                            <a href="/student-schedule">Расписание</a>
                        }
                        <a href="/profile">Профиль</a>
                    </Authorized>
                    <NotAuthorized>
                        <!-- No links -->
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool isStudent = false;
    private bool isTeacher = false;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var email = user.Identity.Name;
            if (email == "admin@example.com")
            {
                isAdmin = true;
            }
            else
            {
                var appUser = await UserManager.GetUserAsync(user);
                if (appUser != null)
                {
                    isStudent = await DbContext.Students.AnyAsync(s => s.ApplicationUserId == appUser.Id);
                    if (!isStudent)
                    {
                        isTeacher = await DbContext.Teachers.AnyAsync(t => t.ApplicationUserId == appUser.Id);
                    }
                }
            }
        }
    }
}
